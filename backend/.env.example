# Database (SQLite by default, change to PostgreSQL when ready)
DATABASE_URL=sqlite:///vst_ims.db

# To use PostgreSQL instead:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vst_ims

SECRET_KEY=change-this-in-production

# SAP Configuration (optional)
SAP_HOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_LANG=EN
